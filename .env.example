ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/isp_ticketing
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
CLIENT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CLIENT_REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=24
GOOGLE_CLIENT_ID=your-google-oauth-client-id
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
